{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "description": "PromQL query expression. Examples: 'up', 'rate(http_requests_total[5m])', 'container_memory_usage_bytes{namespace=\"default\"}', 'kube_pod_container_status_restarts_total{pod=\"my-pod\"}', 'histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))'"
    },
    "time": {
      "type": "string",
      "description": "Evaluation timestamp. Accepts RFC3339 or Unix timestamp in seconds. Defaults to current server time"
    },
    "timeout": {
      "type": "string",
      "description": "Evaluation timeout duration (e.g. '30s', '1m')"
    }
  },
  "required": ["query"]
}
